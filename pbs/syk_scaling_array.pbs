#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N syk_scaling
#PBS -j oe

set -euo pipefail

: "${PROJECT_DIR:?PROJECT_DIR was not exported}"
: "${RESULT_DIR:?RESULT_DIR was not exported}"
: "${NUM_NODES:?NUM_NODES was not exported}"
: "${PBS_ARRAY_INDEX:?This must be submitted as a PBS array job}"

cd "$PROJECT_DIR"
if [[ -n "${PBS_ENV_SCRIPT:-}" ]]; then
    # shellcheck source=/dev/null
    source "$PBS_ENV_SCRIPT"
fi

if ! [[ "$PBS_ARRAY_INDEX" =~ ^[1-9][0-9]*$ ]]; then
    echo "PBS_ARRAY_INDEX must be positive: $PBS_ARRAY_INDEX" >&2
    exit 2
fi
task_index=$((PBS_ARRAY_INDEX - 1))
uv_executable=${UV_EXECUTABLE:-uv}

"$uv_executable" run --frozen python -u syk_scaling_experiment.py run \
    --output-dir "$RESULT_DIR" \
    --task-index "$task_index" \
    --num-tasks "$NUM_NODES" \
    --tau-workers "$TAU_WORKERS" \
    --min-qubits "$MIN_QUBITS" \
    --max-qubits "$MAX_QUBITS" \
    --num-realizations "$NUM_REALIZATIONS" \
    --statevector-max-qubits "$STATEVECTOR_MAX_QUBITS" \
    --coupling-scale "$COUPLING_SCALE" \
    --number-of-steps "$NUMBER_OF_STEPS" \
    --num-initial-states "$NUM_INITIAL_STATES" \
    --num-trajectories "$NUM_TRAJECTORIES" \
    --max-group-size "$MAX_GROUP_SIZE" \
    --base-seed "$BASE_SEED" \
    --num-workers "$NUM_WORKERS" \
    --trajectory-chunks-per-state "$TRAJECTORY_CHUNKS_PER_STATE"
