#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N aggregate_molecular
#PBS -j oe
#PBS -l select=1:ncpus=1:mem=8gb
#PBS -l walltime=00:20:00

set -euo pipefail

: "${PROJECT_DIR:?PROJECT_DIR was not exported}"
: "${RESULT_DIR:?RESULT_DIR was not exported}"

cd "$PROJECT_DIR"
if [[ -n "${PBS_ENV_SCRIPT:-}" ]]; then
    # shellcheck source=/dev/null
    source "$PBS_ENV_SCRIPT"
fi

uv_executable=${UV_EXECUTABLE:-uv}
"$uv_executable" run --frozen python molecular_scaling_experiment.py aggregate \
    --output-dir "$RESULT_DIR"
