#!/usr/bin/env bash
#PBS -S /bin/bash
#PBS -N qdrift_merge
#PBS -j oe
#PBS -l select=1:ncpus=1:mem=4gb
#PBS -l walltime=00:10:00

set -euo pipefail

: "${PROJECT_DIR:?Export PROJECT_DIR when submitting this job}"
: "${RESULT_DIR:?Export RESULT_DIR when submitting this job}"

cd "$PROJECT_DIR"
if [[ -n "${PBS_ENV_SCRIPT:-}" ]]; then
    # shellcheck source=/dev/null
    source "$PBS_ENV_SCRIPT"
fi

uv_executable=${UV_EXECUTABLE:-uv}
"$uv_executable" run --frozen python -u qdrift_metric_comparison.py \
    --merge-partials "$RESULT_DIR"
